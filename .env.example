# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# URA_ACCESS_KEY: Required for Singapore Urban Redevelopment Authority (URA) DataService API.
# Obtain a free key from the URA Developer Portal: https://www.ura.gov.sg/maps/api/
# Configure this under Vercel Settings > Environment Variables or in your local .env file.
URA_ACCESS_KEY="MY_URA_ACCESS_KEY"

# ONEMAP_EMAIL & ONEMAP_PASSWORD: Required for Singapore Land Authority (SLA) OneMap API Token & Search.
# Register for a free developer account at: https://www.onemap.gov.sg/apidocs/
ONEMAP_EMAIL="your_email@domain.com"
ONEMAP_PASSWORD="your_onemap_password"

# ONEMAP_ACCESS_TOKEN: Optional pre-generated token for OneMap REST services.
ONEMAP_ACCESS_TOKEN="MY_ONEMAP_ACCESS_TOKEN"
